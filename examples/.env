# Copy to examples/.env; keep the copy private.
TZ=UTC

PROJECT_MEMORY_LOG_LEVEL=Warning
# Optional shared MCP bearer token. Empty disables application token authentication.
PROJECT_MEMORY_BEARER_TOKEN=

# Required only when starting the optional openai-tunnel profile.
OPENAI_TUNNEL_LOG_LEVEL=warn
OPENAI_TUNNEL_API_KEY=
OPENAI_TUNNEL_ID=
